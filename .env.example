# Copie a .env y reemplace las credenciales antes de usar producción.
DATABASE_URL="postgresql://betel_app:betel_app_local@localhost:5433/betel?schema=public"
BETEL_API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
JWT_SECRET="reemplaza-este-valor-con-un-secreto-de-32-caracteres-o-mas"
# Solo para datos demostrativos locales. Nunca activar en producción.
BETEL_ALLOW_INSECURE_DEV_AUTH="false"
