# Copie a .env y reemplace las credenciales antes de usar producción.
DATABASE_URL="postgresql://betel_app:betel_app_local@localhost:5433/betel?schema=public"
BETEL_API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
JWT_SECRET="reemplaza-este-valor-con-un-secreto-de-32-caracteres-o-mas"
# Solo para datos demostrativos locales. Nunca activar en producción.
BETEL_ALLOW_INSECURE_DEV_AUTH="false"

# Envío de correos (SMTP). Sin SMTP_HOST el botón "Enviar por correo" responde que falta configurarlo.
# Desarrollo: Mailpit (docker compose --profile mail up -d), bandeja en http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Betel Solution <facturacion@betel.local>"

# Pasarela de pagos (Gestión de cobro cartera Betel). "sandbox" simula los pagos; no se permite en producción.
PAYMENT_PROVIDER="sandbox"

# Generación automática de facturas recurrentes (al arrancar y cada hora). "false" la desactiva.
RECURRING_SCHEDULER="true"
