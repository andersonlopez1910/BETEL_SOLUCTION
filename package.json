{
  "name": "betel-solution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @betel/web --filter @betel/api dev",
    "build": "corepack pnpm --filter @betel/web --filter @betel/api run build",
    "typecheck": "corepack pnpm -r run typecheck",
    "test": "corepack pnpm --filter @betel/api test",
    "db:generate": "corepack pnpm --filter @betel/db generate",
    "db:push": "corepack pnpm --filter @betel/db push",
    "db:rls": "corepack pnpm --filter @betel/db rls"
  },
  "devDependencies": { "turbo": "^2.11.8", "typescript": "5.9.3" }
}
